VITE_APP_API_URL=
VITE_APP_REDIRECT_URL=http://localhost:5173
VITE_APP_GOOGLE_CLIENT_ID=USE_YOUR_OWN_CLIENT_ID
VITE_IS_SELF_HOSTED=true

# Family kiosk mode (LAN-only, family-only deployment).
# When both the username and password are set, the app silently logs in with this
# shared account on boot, never shows the login screen, and makes the Family view
# the home screen. Leave blank to keep the normal login flow.
#
# In the cluster these are NOT set here — they're injected at runtime via
# window.__DONETICK_ENV__ from the SOPS-encrypted donetick-frontend-config secret
# (mounted at /config.js), so the shared password stays out of the bundle and git.
# These build-time vars remain only as a local-dev fallback.
VITE_APP_FAMILY_USERNAME=
VITE_APP_FAMILY_PASSWORD=
